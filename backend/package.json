{
  "name": "ktm-ride-backend",
  "version": "0.1.0",
  "description": "Backend API for the RidePulse motorcycle ride tracking and navigation app.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "rides:dedupe": "node scripts/removeDuplicateRides.js",
    "rides:dedupe:api": "node scripts/removeDuplicateRidesViaApi.js",
    "rides:dedupe:prompt": "powershell -ExecutionPolicy Bypass -File ./scripts/remove-duplicate-rides.ps1",
    "test": "node tests/rideMath.test.js && node tests/journalIntelligence.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
